/* ===== Reset & Base ===== */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
    --bg: #ffffff;
    --bg-secondary: #f9fafb;
    --bg-tertiary: #f3f4f6;
    --text: #111827;
    --text-secondary: #4b5563;
    --text-tertiary: #9ca3af;
    --text-quaternary: #d1d5db;
    --border: #e5e7eb;
    --border-light: #f3f4f6;
    --blue-50: #eff6ff;
    --blue-100: #dbeafe;
    --blue-200: #bfdbfe;
    --blue-400: #60a5fa;
    --blue-500: #3b82f6;
    --blue-600: #2563eb;
    --blue-700: #1d4ed8;
    --radius: 10px;
    --radius-lg: 14px;
    --radius-xl: 18px;
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
    --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
    --shadow-md: 0 4px 6px rgba(0,0,0,0.04), 0 2px 4px rgba(0,0,0,0.03);
    --max-w: 72rem;
    --font: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", sans-serif;
}

html { scroll-behavior: smooth; }

body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

a { color: inherit; text-decoration: none; }

.container { max-width: var(--max-w); margin: 0 auto; padding: 0 1.5rem; }

/* ===== Header ===== */
.site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

.header-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.5rem;
}

.header-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
}

.header-sub {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: 1px;
}

.site-nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-weight: 500;
}

.site-nav a {
    transition: color 0.15s;
}

.site-nav a:hover {
    color: var(--text);
}

.mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
}

.mobile-menu-btn span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--text-secondary);
    margin: 3.5px 0;
    transition: all 0.3s;
    border-radius: 1px;
}

/* ===== Hero ===== */
.hero-section {
    padding: 5rem 0 3.5rem;
}

.hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: start;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid var(--blue-200);
    background: var(--blue-50);
    padding: 0.2rem 0.625rem;
    font-size: 0.6875rem;
    color: var(--blue-600);
    font-weight: 500;
    margin-bottom: 1.25rem;
    letter-spacing: 0.01em;
}

.hero-title {
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--text);
}

.text-blue {
    color: var(--blue-600);
}

.hero-desc {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 38rem;
    margin-bottom: 2rem;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
}

/* ===== Buttons ===== */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    padding: 0.625rem 1.125rem;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: all 0.15s;
    cursor: pointer;
    border: none;
    font-family: var(--font);
}

.btn-blue {
    background: var(--blue-600);
    color: #fff;
}

.btn-blue:hover {
    background: var(--blue-700);
}

.btn-outline {
    border: 1px solid var(--border);
    color: var(--text-secondary);
    background: #fff;
}

.btn-outline:hover {
    border-color: var(--text-quaternary);
    color: var(--text);
    background: var(--bg-secondary);
}

.btn-white {
    background: var(--text);
    color: #fff;
    border-radius: var(--radius);
    padding: 0.625rem 1.125rem;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.btn-white:hover {
    background: #1f2937;
}

/* ===== Cards ===== */
.card {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: #fff;
    padding: 1.25rem;
    transition: all 0.15s;
    box-shadow: var(--shadow-sm);
}

.card-main {
    margin-bottom: 1rem;
}

.card-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-weight: 500;
}

.card-value {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 0.375rem;
    color: var(--text);
}

.card-text {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-top: 0.625rem;
}

.card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
}

.tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.625rem;
}

.tag {
    border-radius: 9999px;
    border: 1px solid var(--border);
    padding: 0.1875rem 0.625rem;
    font-size: 0.6875rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    font-weight: 450;
}

/* ===== Sections ===== */
.content-section {
    padding: 3.5rem 0;
}

.section-header {
    margin-bottom: 2rem;
}

.section-header-wide {
    max-width: 40rem;
}

.section-tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    font-weight: 500;
}

.section-title {
    font-size: 1.625rem;
    font-weight: 600;
    margin-top: 0.375rem;
    letter-spacing: -0.015em;
    color: var(--text);
}

.section-desc {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-top: 0.5rem;
}

/* ===== Principles ===== */
.principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
}

.card-principle h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text);
}

.card-principle p {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-secondary);
}

/* ===== Projects ===== */
.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
}

.card-project {
    cursor: pointer;
}

.card-project:hover {
    transform: translateY(-2px);
    border-color: var(--blue-200);
    box-shadow: var(--shadow-md);
}

.project-tag {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--blue-600);
    font-weight: 600;
}

.card-project h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-top: 0.625rem;
    color: var(--text);
}

.card-project p {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-top: 0.75rem;
}

.project-outcome {
    margin-top: 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    padding: 0.875rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
}

/* ===== Insights ===== */
.insights-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2rem;
    align-items: start;
}

.insights-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.insight-card {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: #fff;
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.15s;
}

.insight-card:hover {
    border-color: var(--blue-200);
    box-shadow: var(--shadow);
}

.insight-num {
    font-size: 0.6875rem;
    color: var(--text-quaternary);
    font-weight: 600;
}

.insight-text {
    font-size: 0.9375rem;
    font-weight: 500;
    margin-top: 0.375rem;
    color: var(--text);
}

/* ===== Blog ===== */
.blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
}

.card-blog {
    display: flex;
    flex-direction: column;
}

.card-blog:hover {
    border-color: var(--blue-200);
    box-shadow: var(--shadow);
}

.blog-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.625rem;
}

.blog-date {
    font-size: 0.6875rem;
    color: var(--text-tertiary);
}

.blog-tag {
    font-size: 0.6875rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
    padding: 0.0625rem 0.4375rem;
    color: var(--text-tertiary);
    background: var(--bg-secondary);
    font-weight: 450;
}

.blog-title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.4;
    color: var(--text);
}

.blog-excerpt {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    flex: 1;
}

.read-more {
    display: inline-block;
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--blue-600);
    font-weight: 500;
    transition: color 0.15s;
}

.read-more:hover {
    color: var(--blue-700);
}

/* ===== Contact ===== */
.contact-card {
    border-radius: var(--radius-xl);
    border: 1px solid var(--blue-200);
    background: var(--blue-50);
    padding: 2rem;
}

.contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
}

/* ===== GitHub Trending Module ===== */
.github-trending-module *,
.github-trending-module *::before,
.github-trending-module *::after { margin:0; padding:0; box-sizing:border-box; }
.github-trending-module { font-family: var(--font); color: var(--text); line-height: 1.6; }
.github-trending-module .gtm-header { background: var(--bg); border-bottom: 1px solid var(--border); padding: 20px 0 14px; text-align: center; }
.github-trending-module .gtm-header-inner { max-width: 960px; margin: 0 auto; padding: 0 24px; }
.github-trending-module .gtm-header-top { display: flex; align-items: baseline; justify-content: center; gap: 16px; margin-bottom: 8px; flex-wrap: wrap; }
.github-trending-module .gtm-logo { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; color: var(--text); }
.github-trending-module .gtm-logo span { color: var(--blue-600); }
.github-trending-module .gtm-date { font-size: 13px; color: var(--text-tertiary); border-left: 1px solid var(--border); padding-left: 16px; }
.github-trending-module .gtm-summary { font-size: 13px; color: var(--text-secondary); background: var(--blue-50); border: 1px solid var(--blue-100); border-radius: 6px; padding: 8px 16px; display: inline-block; margin-top: 8px; }
.github-trending-module .gtm-tabs { background: var(--bg); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10; }
.github-trending-module .gtm-tabs-inner { max-width: 960px; margin: 0 auto; padding: 0 24px; display: flex; overflow-x: auto; }
.github-trending-module .gtm-tab { padding: 12px 20px; font-size: 14px; font-weight: 500; color: var(--text-tertiary); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: all 0.15s; white-space: nowrap; }
.github-trending-module .gtm-tab:hover { color: var(--text-secondary); }
.github-trending-module .gtm-tab.active { color: var(--blue-600); border-bottom-color: var(--blue-600); }
.github-trending-module .gtm-content { max-width: 960px; margin: 0 auto; padding: 24px 24px; }
.github-trending-module .gtm-panel { display: none; }
.github-trending-module .gtm-panel.active { display: block; }
.github-trending-module .gtm-section { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 16px; overflow: hidden; box-shadow: var(--shadow-sm); }
.github-trending-module .gtm-section-header { padding: 14px 16px; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; gap: 8px; }
.github-trending-module .gtm-section-title { font-size: 15px; font-weight: 600; color: var(--text); }
.github-trending-module .gtm-section-icon { font-size: 16px; }
.github-trending-module table { width: 100%; border-collapse: collapse; }
.github-trending-module th { background: var(--bg-secondary); padding: 8px 12px; text-align: left; font-size: 12px; font-weight: 600; color: var(--text-tertiary); border-bottom: 1px solid var(--border); text-transform: uppercase; letter-spacing: 0.04em; }
.github-trending-module td { padding: 10px 12px; font-size: 13px; border-bottom: 1px solid var(--border-light); vertical-align: middle; }
.github-trending-module tr:last-child td { border-bottom: none; }
.github-trending-module tr:hover td { background: var(--bg-secondary); }
.github-trending-module .gtm-rank { font-weight: 600; color: var(--text-tertiary); font-size: 12px; width: 32px; }
.github-trending-module .gtm-rank.top3 { color: var(--blue-600); }
.github-trending-module .gtm-proj-name { font-weight: 600; color: var(--blue-600); text-decoration: none; }
.github-trending-module .gtm-proj-name:hover { text-decoration: underline; }
.github-trending-module .gtm-proj-sub { font-size: 11px; color: var(--text-tertiary); margin-top: 2px; }
.github-trending-module .gtm-lang-tag { display: inline-block; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 500; background: var(--bg-secondary); color: var(--text-secondary); border: 1px solid var(--border); }
.github-trending-module .gtm-lang-Python { background: var(--blue-50); color: var(--blue-600); border-color: var(--blue-100); }
.github-trending-module .gtm-lang-TypeScript { background: #f0fdf4; color: #16a34a; border-color: #dcfce7; }
.github-trending-module .gtm-lang-Rust { background: #fff7ed; color: #ea580c; border-color: #ffedd5; }
.github-trending-module .gtm-lang-Kotlin { background: #faf5ff; color: #9333ea; border-color: #f3e8ff; }
.github-trending-module .gtm-stars { font-weight: 600; color: var(--text-secondary); }
.github-trending-module .gtm-stars-new { color: var(--blue-600); font-weight: 600; }
.github-trending-module .gtm-insight-list { padding: 16px; }
.github-trending-module .gtm-insight-item { margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border-light); }
.github-trending-module .gtm-insight-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.github-trending-module .gtm-insight-repo { font-size: 12px; font-weight: 600; color: var(--blue-600); margin-bottom: 6px; }
.github-trending-module .gtm-insight-date { font-weight: 400; color: var(--text-tertiary); font-size: 11px; }
.github-trending-module .gtm-insight-text { font-size: 13px; color: var(--text-secondary); line-height: 1.75; }
.github-trending-module .gtm-signal-tags { padding: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
.github-trending-module .gtm-signal-tag { padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-weight: 500; }
.github-trending-module .gtm-tag-hot { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
.github-trending-module .gtm-tag-rising { background: #fffbeb; color: #d97706; border: 1px solid #fde68a; }
.github-trending-module .gtm-tag-watch { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
.github-trending-module .gtm-invest-cards { padding: 16px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
.github-trending-module .gtm-invest-card { border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; background: var(--bg-secondary); }
.github-trending-module .gtm-invest-dir { font-size: 14px; font-weight: 600; margin-bottom: 6px; color: var(--text); }
.github-trending-module .gtm-invest-proj { font-size: 11px; color: var(--text-tertiary); margin-bottom: 8px; }
.github-trending-module .gtm-invest-bar-wrap { background: var(--border); border-radius: 4px; height: 5px; margin-bottom: 8px; }
.github-trending-module .gtm-invest-bar { height: 5px; border-radius: 4px; }
.github-trending-module .gtm-bar-strong { background: var(--blue-600); width: 90%; }
.github-trending-module .gtm-bar-mid { background: var(--blue-400); width: 60%; }
.github-trending-module .gtm-bar-watch { background: var(--text-quaternary); width: 35%; }
.github-trending-module .gtm-invest-strength { font-size: 11px; margin-bottom: 2px; }
.github-trending-module .gtm-str-strong { color: var(--blue-600); font-weight: 600; }
.github-trending-module .gtm-str-mid { color: var(--blue-400); font-weight: 600; }
.github-trending-module .gtm-str-watch { color: var(--text-tertiary); font-weight: 600; }
.github-trending-module .gtm-footer { text-align: center; padding: 20px; color: var(--text-tertiary); font-size: 11px; border-top: 1px solid var(--border); margin-top: 8px; }
@media(max-width:640px){
  .github-trending-module .gtm-invest-cards { grid-template-columns: 1fr; }
  .github-trending-module .gtm-tab { padding: 10px 14px; font-size: 13px; }
  .github-trending-module .gtm-header-top { flex-direction: column; gap: 8px; }
  .github-trending-module .gtm-date { border-left: none; padding-left: 0; }
}

/* ===== GitHub Trending 独立页面 ===== */
.gtm-page-hero {
    background: var(--bg);
    padding: 4rem 0 1.5rem;
    text-align: center;
    position: relative;
    border-bottom: 1px solid var(--border-light);
}
.gtm-back-link {
    position: absolute;
    left: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-tertiary);
    font-size: 0.875rem;
    transition: color 0.15s;
    opacity: 0.5;
}
.gtm-back-link:hover {
    color: var(--text);
    opacity: 1;
}
.gtm-page-hero h1 {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
}
.gtm-page-hero .gtm-page-subtitle {
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    margin-top: 0.25rem;
}

/* ===== Footer ===== */
.site-footer {
    text-align: center;
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
    color: var(--text-tertiary);
    font-size: 0.75rem;
}

.site-footer p + p {
    margin-top: 0.125rem;
}

/* ===== Responsive ===== */
@media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-title { font-size: 1.75rem; }
    .principles-grid, .projects-grid, .blog-grid { grid-template-columns: 1fr; }
    .insights-grid { grid-template-columns: 1fr; }
    .card-grid { grid-template-columns: 1fr; }
    .site-nav { display: none; }
    .mobile-menu-btn { display: block; }
    .contact-card { padding: 1.5rem; }
    .section-title { font-size: 1.375rem; }
}
