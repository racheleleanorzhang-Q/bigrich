---
import { getCollection } from "astro:content";
import SlashArticleLayout from "../../layouts/SlashArticleLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const allPosts = (await getCollection("slash", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

export async function getStaticPaths() {
  const posts = await getCollection("slash", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);
---

<SlashArticleLayout post={post}>
  <slot />

  {/* Related Articles */}
  {relatedPosts.length > 0 && (
    <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid var(--border);">
      <h3 style="font-size:1.125rem;font-weight:600;margin-bottom:1rem;">相关文章</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;">
        {relatedPosts.map((p) => (
          <ArticleCard post={p} />
        ))}
      </div>
    </div>
  )}
</SlashArticleLayout>
